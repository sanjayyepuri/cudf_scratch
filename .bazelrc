# Keep the build cache on WSL's Linux filesystem.
startup --output_user_root=/tmp/cudf-hermetic-bazel
build --platforms=//:linux_x86_64
build --repo_env=BAZEL_DO_NOT_DETECT_CPP_TOOLCHAIN=1
build --spawn_strategy=sandboxed
# Bazel 9 requires an execution platform matching the test target's constraints.
test --extra_execution_platforms=//:linux_x86_64
